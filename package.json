{
  "name": "chatgpt-mcp-bridge",
  "version": "1.0.0",
  "description": "An MCP server that connects Claude to ChatGPT (OpenAI models): ask questions, keep multi-turn threads, get second opinions and code reviews, and generate images, all from inside Claude.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chatgpt-mcp-bridge": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-executable.mjs",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "check-key": "node scripts/check-openai-key.mjs",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "chatgpt",
    "openai",
    "anthropic",
    "llm",
    "ai-bridge"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "openai": "^7.64.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myrahossain36-svg/chatgpt-mcp-bridge.git"
  },
  "homepage": "https://github.com/myrahossain36-svg/chatgpt-mcp-bridge#readme",
  "bugs": {
    "url": "https://github.com/myrahossain36-svg/chatgpt-mcp-bridge/issues"
  }
}
