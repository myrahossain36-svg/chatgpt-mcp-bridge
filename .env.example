# ChatGPT MCP Bridge configuration
# Copy to .env (never commit .env) or put these in the "env" block of your Claude config.

# ---- Required ---------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# ---- Models -----------------------------------------------------------------
# Default chat model when Claude does not ask for a specific one.
OPENAI_MODEL=gpt-5.6-sol
# Image model for chatgpt_generate_image.
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional comma-separated allow-list. Leave empty to allow any model.
ALLOWED_MODELS=

# ---- Other OpenAI-compatible providers (Azure, OpenRouter, Ollama, LM Studio)
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# ---- Limits -----------------------------------------------------------------
MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_MS=120000
MAX_RETRIES=2

# ---- Conversations ----------------------------------------------------------
MAX_HISTORY_MESSAGES=40
MAX_CONVERSATIONS=200
CONVERSATION_TTL_MINUTES=1440
# Set a path to keep conversations after restarts, e.g. ./data/conversations.json
CONVERSATION_STORE_PATH=

# ---- Extras -----------------------------------------------------------------
# Save generated images here as well as returning them to Claude.
IMAGE_OUTPUT_DIR=
# Applied to every ChatGPT call unless a tool call gives its own system prompt.
DEFAULT_SYSTEM_PROMPT=
LOG_LEVEL=info

# ---- HTTP mode only (npm run start:http) -------------------------------------
HOST=127.0.0.1
PORT=3000
# Strongly recommended for anything beyond localhost. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Extra Host headers allowed when binding to 0.0.0.0, e.g. bridge.example.com
ALLOWED_HOSTS=
CORS_ORIGINS=
