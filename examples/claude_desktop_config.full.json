{
  "mcpServers": {
    "chatgpt": {
      "command": "node",
      "args": ["/absolute/path/to/chatgpt-mcp-bridge/dist/index.js"],
      "env": {
        "OPENAI_API_KEY": "sk-your-key-here",
        "OPENAI_MODEL": "gpt-5.6-sol",
        "OPENAI_IMAGE_MODEL": "gpt-image-2",
        "ALLOWED_MODELS": "gpt-5.6-sol,gpt-6.1-terra,gpt-image-2",
        "MAX_OUTPUT_TOKENS": "4096",
        "CONVERSATION_STORE_PATH": "/absolute/path/to/chatgpt-mcp-bridge/data/conversations.json",
        "IMAGE_OUTPUT_DIR": "/absolute/path/to/Pictures/chatgpt",
        "DEFAULT_SYSTEM_PROMPT": "You are being consulted by another AI assistant. Be concise and precise.",
        "LOG_LEVEL": "info"
      }
    }
  }
}
